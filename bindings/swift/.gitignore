# Patterns are relative to this file's directory, so they must not repeat it.
# Written as `bindings/swift/.build/` these expanded to
# `bindings/swift/bindings/swift/.build/` and never matched anything; the build
# directories were only ignored incidentally, by the root *.a and *.o rules.
.build/
.build-libs/
.cmake-build/
.cmake-build-arm64/
.cmake-build-x86_64/
.xcframework-staging/
