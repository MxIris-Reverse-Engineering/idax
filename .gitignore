.claude/
# Compiled files
*.a
*.dll
*.dylib
*.exe
*.la
*.lib
*.lo
*.o
*.obj
*.out
*.so
*.so.*

# Cache
*.pyc
__pycache__/

# Build directories
src/bin
obj/
build/
# Anchored: unanchored `build*/` also matches nested directories, and on a
# case-insensitive filesystem it swallows source directories such as
# bindings/swift/Plugins/BuildXCFramework/. `build/` above still covers
# nested build directories at any depth.
/build*/

# Workflow-owned SDK/runtime acquisition roots
ida-installer/
ida-sdk/

# Workspace
_wks/

# OS Files
# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
*.pdb
node_modules/
target/

# SwiftPM local products and workspace metadata
.build/
.swiftpm/

# Node native build may be a symlink to an external build directory.
/bindings/node/build

# Fork-only: CMake build trees for the prebuilt-artifact route and the
# XCFramework staging area used by bindings/swift/scripts.
.cmake-build
.cmake-build-*
.xcframework-staging
.worktrees/
